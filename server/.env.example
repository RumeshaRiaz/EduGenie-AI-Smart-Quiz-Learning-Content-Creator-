# Anthropic API key.
# Copy this file to `.env` and put the real key THERE, not here.
# `.env.example` is committed to git; `.env` is ignored.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for question generation.
ANTHROPIC_MODEL=claude-opus-5

# Port the API listens on.
PORT=8787

# Comma-separated list of allowed origins. Leave unset to allow all.
# The mobile app sends no browser Origin header, so this only matters if a
# website will call the API.
# CORS_ORIGINS=https://your-app.example.com

# How many AI/file requests one IP address may make per hour.
RATE_LIMIT_PER_HOUR=60
