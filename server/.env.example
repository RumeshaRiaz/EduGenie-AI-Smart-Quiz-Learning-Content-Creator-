# ---------------------------------------------------------------------------
# AI provider. Set ONE of the keys below; copy this file to `.env` and put the
# real key THERE. `.env.example` is committed to git, `.env` is ignored.
# ---------------------------------------------------------------------------

# Google Gemini — has a genuine free tier, so this is the default.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic — paid only, no free tier. Leave blank unless you have credits.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Force a provider when both keys are set. Otherwise Gemini wins.
# AI_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the API listens on. Hosting platforms set this themselves.
PORT=8787

# Comma-separated list of allowed origins. Leave unset to allow all.
# The mobile app sends no browser Origin header, so this only matters if a
# website will call the API.
# CORS_ORIGINS=https://your-app.example.com

# How many AI/file requests one IP address may make per hour.
RATE_LIMIT_PER_HOUR=60
